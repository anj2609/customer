<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <uses-permission
        android:name="android.permission.CAMERA"/>
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <!-- Required from Android 13 (API 33) onward for the app to post any
         notification at all — including the ones Firebase Cloud Messaging
         puts in the system tray while the app is backgrounded. It was
         missing entirely, so on any modern phone every notification was
         dropped by the OS before it could be shown, and
         FirebaseMessaging.requestPermission() in main.dart had nothing to
         grant: a runtime permission can only be requested if it is
         declared here first. The driver app has always declared it, which
         is why notifications worked there and not here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="N ride"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/LaunchTheme">
        <!-- UCrop -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- MAIN ACTIVITY -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Flutter themes -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Google Maps API -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
             android:value="AIzaSyBNHiJLxFa2qcs079P5TaYrB770_CVMldU"/>
            
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <!-- Tells FCM which channel to post background/system-tray
             notifications on. Without it, messages arriving while the app is
             backgrounded land on a fallback channel this app never
             configures, so they can be silently downgraded to minimal
             importance. Matches the channel main.dart creates explicitly on
             startup, and mirrors what the driver app already declares. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel"/>
        <!-- A tombstone from the driver app (same Flutter version, same
             image-decode-heavy marker/photo loading pattern this app also
             has) showed a native SIGSEGV in flutter::ImageDecoderImpeller::
             UnsafeUploadTextureToPrivate -> impeller::CommandQueueVK::Submit
             -> pthread_mutex_lock, on the engine's background image-decode
             thread pool (fml::ConcurrentMessageLoop) — a known Impeller-on-
             Android/Vulkan crash under concurrent texture uploads. It's a
             threading bug inside the engine's Vulkan backend itself, not
             something fixable from app code. Falling back to the older
             Skia/OpenGL renderer (Impeller's default before Flutter 3.29,
             and still far more battle-tested on Android) sidesteps it. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>